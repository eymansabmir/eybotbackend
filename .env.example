# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# MONGODB_URI=mongodb://localhost:27017/flowbuilder
DATABASE_URL=postgresql://user:password@localhost:5432/flowbuilder?schema=public

# Cache Configuration
REDIS_URL=redis://localhost:6379

# WhatsApp channel provider: meta | interakt | stub
# If omitted: meta when Meta creds present, else interakt when INTERAKT_API_KEY set, else stub
WHATSAPP_PROVIDER=meta

# Meta Cloud API (when WHATSAPP_PROVIDER=meta)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Interakt BSP (when WHATSAPP_PROVIDER=interakt)
# Supports outbound Template + Sticker; inbound via /api/webhooks/interakt
INTERAKT_API_URL=https://api.interakt.ai/v1
INTERAKT_API_KEY=
INTERAKT_DEFAULT_COUNTRY_CODE=+91
INTERAKT_WEBHOOK_SECRET=
# Same role as Meta phone_number_id — used for session locks + credential lookup
INTERAKT_WA_BUSINESS_NUMBER=
# Optional fallback org if webhook URL has no /:orgId and credential lookup fails
INTERAKT_ORG_ID=
# Optional credential id for env-scoped BSP webhook inbound jobs
INTERAKT_CREDENTIAL_ID=
# Exact Interakt/BSP webhook mount (skips credential DB lookup when set)
# e.g. /api/v1/workspaces/ws_123456/whatsapp/cred_789012/webhook
BSP_WEBHOOK_PATH=
BSP_WEBHOOK_BYPASS_CREDENTIAL_LOOKUP=true

# Storage Configuration
# Options: gcs, s3, azure
STORAGE_PROVIDER=gcs
BASE_MEDIA_URL=

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
# Optional: either GCS_KEY_FILE (path) or GCS_CREDENTIALS_JSON (raw JSON or base64 JSON)
GCS_KEY_FILE=
GCS_CREDENTIALS_JSON=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCESS_KEY=
AZURE_CONTAINER_NAME=
