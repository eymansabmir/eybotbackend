# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# MONGODB_URI=mongodb://localhost:27017/flowbuilder
DATABASE_URL=postgresql://user:password@localhost:5432/flowbuilder?schema=public

# Cache Configuration
REDIS_URL=redis://localhost:6379
# Set true for Azure Cache for Redis (OSS cluster / Enterprise). Fixes ReplyError: MOVED …
# REDIS_CLUSTER=true
# Use rediss:// for TLS, e.g. rediss://:password@yourcache.redis.cache.windows.net:6380

# WhatsApp channel provider: meta | interakt | stub
# If omitted: meta when Meta creds present, else interakt when INTERAKT_API_KEY set, else stub
WHATSAPP_PROVIDER=meta

# Meta Cloud API (when WHATSAPP_PROVIDER=meta)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Interakt BSP (when WHATSAPP_PROVIDER=interakt)
# Supports outbound Template + Sticker; inbound via /api/webhooks/interakt
INTERAKT_API_URL=https://api.interakt.ai/v1
INTERAKT_API_KEY=
INTERAKT_DEFAULT_COUNTRY_CODE=+91
INTERAKT_WEBHOOK_SECRET=
# Same role as Meta phone_number_id — used for session locks + credential lookup
INTERAKT_WA_BUSINESS_NUMBER=
# Optional fallback org if webhook URL has no /:orgId and credential lookup fails
INTERAKT_ORG_ID=
# Optional credential id for env-scoped BSP webhook inbound jobs
INTERAKT_CREDENTIAL_ID=
# Exact Interakt/BSP webhook mount (skips credential DB lookup when set)
# e.g. /api/v1/workspaces/ws_123456/whatsapp/cred_789012/webhook
BSP_WEBHOOK_PATH=
BSP_WEBHOOK_BYPASS_CREDENTIAL_LOOKUP=true

# EY Managed Services WhatsApp Assistant (RAG)
# When true, unmatched chat (no active session / no intent) falls through to GenAI.
MANAGED_SERVICES_ASSISTANT_ENABLED=false
# Default EY path: Copilot SDK chat + local Xenova embeddings + pgvector on DATABASE_URL.
OPENAI_API_KEY=                    # GitHub fine-grained PAT with Copilot access
# GITHUB_TOKEN=                    # optional fallback
MS_ASSISTANT_LLM_PROVIDER=copilot  # copilot | openai
MS_ASSISTANT_EMBED_PROVIDER=local  # local (384-d, required for pgvector) | openai
MS_ASSISTANT_CHAT_MODEL=gpt-4.1
MS_ASSISTANT_LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
MS_ASSISTANT_VECTOR_STORE=pgvector # pgvector (default) | qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=ey_managed_services_local
MS_ASSISTANT_TOP_K=5
MS_ASSISTANT_MEMORY_TTL_SEC=86400
MS_ASSISTANT_KNOWLEDGE_DIR=knowledge/managed-services
# Optional OpenAI-compatible path (not for EY Copilot-only policy):
# MS_ASSISTANT_LLM_PROVIDER=openai
# MS_ASSISTANT_EMBED_PROVIDER=openai
# OPENAI_BASE_URL=https://...
# MS_ASSISTANT_EMBED_MODEL=text-embedding-3-small
# MS_ASSISTANT_JSON_OBJECT=true


# Storage Configuration
# Options: gcs, s3, azure
STORAGE_PROVIDER=gcs
BASE_MEDIA_URL=

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
# Optional: either GCS_KEY_FILE (path) or GCS_CREDENTIALS_JSON (raw JSON or base64 JSON)
GCS_KEY_FILE=
GCS_CREDENTIALS_JSON=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCESS_KEY=
AZURE_CONTAINER_NAME=
