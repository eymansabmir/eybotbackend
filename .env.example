# Server Configuration
NODE_ENV=development
# Feature flags (src/config/feature-flags.ts)
# APP_ENV picks the default slice when FEATURE_* is unset: dev | uat | prod
# APP_ENV=dev
#
# Override any flag without redeploying — restart container / reload env is enough:
# FEATURE_BSP_PROVIDER_META=true
# FEATURE_BSP_PROVIDER_INTERAKT=false
# (Enable only one BSP provider; Meta wins if both are true.)

# Docker entrypoint: after migrate, optionally rebuild MS knowledge vectors (wipes store).
# Leave false on normal restarts; set true for first deploy or after knowledge/ markdown changes.
# RUN_MS_KB_INGEST=false
PORT=3000

# Database Configuration
# MONGODB_URI=mongodb://localhost:27017/flowbuilder
DATABASE_URL=postgresql://user:password@localhost:5432/flowbuilder?schema=public

# Cache Configuration
REDIS_URL=redis://localhost:6379
# Set true for Azure Cache for Redis (OSS cluster / Enterprise). Fixes ReplyError: MOVED …
# REDIS_CLUSTER=true
# Use rediss:// for TLS, e.g. rediss://:password@yourcache.redis.cache.windows.net:6380

# WhatsApp channel provider (optional manual override — wins over FEATURE_* flags).
# If unset, provider follows FEATURE_BSP_PROVIDER_META / FEATURE_BSP_PROVIDER_INTERAKT.
# WHATSAPP_PROVIDER=meta | interakt | stub
# WHATSAPP_PROVIDER=interakt

# Meta Cloud API (needed when BSP_PROVIDER_META is true)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Interakt BSP (needed when BSP_PROVIDER_INTERAKT is true)
# Supports outbound Template + Sticker; inbound via /api/webhooks/interakt
INTERAKT_API_URL=https://api.interakt.ai/v1
INTERAKT_API_KEY=
INTERAKT_DEFAULT_COUNTRY_CODE=+91
INTERAKT_WEBHOOK_SECRET=
# Same role as Meta phone_number_id — used for session locks + credential lookup
INTERAKT_WA_BUSINESS_NUMBER=
# Optional fallback org if webhook URL has no /:orgId and credential lookup fails
INTERAKT_ORG_ID=
# Optional credential id for env-scoped BSP webhook inbound jobs
INTERAKT_CREDENTIAL_ID=
# Exact Interakt/BSP webhook mount (skips credential DB lookup when set)
# e.g. /api/v1/workspaces/ws_123456/whatsapp/cred_789012/webhook
BSP_WEBHOOK_PATH=
BSP_WEBHOOK_BYPASS_CREDENTIAL_LOOKUP=true

# EY Managed Services WhatsApp Assistant (RAG)
# When true, unmatched chat (no active session / no intent) falls through to GenAI.
MANAGED_SERVICES_ASSISTANT_ENABLED=false
# Chat: openai = direct api.openai.com | copilot = GitHub Copilot SDK
# GITHUB_TOKEN=                    # optional fallback
MS_ASSISTANT_LLM_PROVIDER=openai   # openai (direct api.openai.com) | copilot (GitHub Copilot SDK)
MS_ASSISTANT_EMBED_PROVIDER=local  # local (384-d, required for pgvector) | openai
MS_ASSISTANT_CHAT_MODEL=gpt-4o     # e.g. gpt-4o, gpt-4o-mini, gpt-4.1
MS_ASSISTANT_LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
MS_ASSISTANT_VECTOR_STORE=pgvector # pgvector (default) | qdrant
# OPENAI_BASE_URL=                 # only for proxies; omit for direct OpenAI
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=ey_managed_services_local
MS_ASSISTANT_TOP_K=5
MS_ASSISTANT_MEMORY_TTL_SEC=86400
# Bot profile: managed-services (default) | honda-mechanic | morth | hero
MS_ASSISTANT_BOT_PROFILE=managed-services
MS_ASSISTANT_KNOWLEDGE_DIR=knowledge/managed-services
# Honda mechanic example:
# MS_ASSISTANT_BOT_PROFILE=honda-mechanic
# MS_ASSISTANT_KNOWLEDGE_DIR=knowledge/honda-activa-mechanic
# MoRTH / Parivahan example:
# MS_ASSISTANT_BOT_PROFILE=morth
# MS_ASSISTANT_KNOWLEDGE_DIR=knowledge/morth
# Hero MotoCorp sales / lead warming example:
# MS_ASSISTANT_BOT_PROFILE=hero
# MS_ASSISTANT_KNOWLEDGE_DIR=knowledge/hero_rag_knowledgebase
# Optional OpenAI-compatible path (not for EY Copilot-only policy):
# Fallback when Copilot SDK is unavailable:
# MS_ASSISTANT_LLM_PROVIDER=openai
# MS_ASSISTANT_EMBED_PROVIDER=local
# OPENAI_API_KEY=sk-...
# MS_ASSISTANT_CHAT_MODEL=gpt-4o


# Storage Configuration
# Options: gcs, s3, azure
STORAGE_PROVIDER=gcs
BASE_MEDIA_URL=

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
# Optional: either GCS_KEY_FILE (path) or GCS_CREDENTIALS_JSON (raw JSON or base64 JSON)
GCS_KEY_FILE=
GCS_CREDENTIALS_JSON=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCESS_KEY=
AZURE_CONTAINER_NAME=
