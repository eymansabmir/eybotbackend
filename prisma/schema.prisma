generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model Flow {
  id            String     @id @default(uuid())
  orgId         String
  name          String
  description   String?
  status        FlowStatus @default(draft)
  version       Int        @default(1)

  triggerType   String
  triggerConfig Json

  nodes         Json
  edges         Json
  settings      Json

  publishedAt   DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  campaigns     Campaign[]

  @@index([orgId, status])
}

model Session {
  id                String        @id @default(uuid())

  flowId            String
  flowVersion       Int

  contactId         String?
  waId              String
  waBusinessNumber  String

  status            SessionStatus @default(active)

  currentNodeId     String

  variables         Json?
  history           Json?

  waitingFor        Json?

  isCurrent         Boolean       @default(true)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([waId, status])
  @@index([flowId, status])
  @@index([waBusinessNumber, waId, isCurrent])
}

model Contact {
  id           String   @id @default(uuid())

  orgId        String
  waId         String
  name         String

  tags         String[]
  customFields Json?

  optIn        Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, waId])
  @@index([orgId])
}

model Campaign {
  id              String         @id @default(uuid())
  orgId           String
  name            String
  flowId          String
  scheduleTime    DateTime?
  status          CampaignStatus @default(draft)
  activeVersionId String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  flow            Flow          @relation(fields: [flowId], references: [id])
  versions        CampaignVersion[]
  stats           CampaignStats?

  @@index([orgId, status])
}

model CampaignVersion {
  id            String                @id @default(uuid())
  campaignId    String
  filePath      String
  versionNumber Int
  status        CampaignVersionStatus @default(draft)

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  campaign      Campaign              @relation(fields: [campaignId], references: [id])
  recipients    CampaignRecipient[]

  @@index([campaignId])
}

model CampaignRecipient {
  id                String            @id @default(uuid())
  campaignVersionId String
  waId              String
  variables         Json?
  status            RecipientStatus   @default(pending)
  attempts          Int               @default(0)
  sentAt            DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  version           CampaignVersion   @relation(fields: [campaignVersionId], references: [id])

  @@index([campaignVersionId, status])
  @@index([waId])
}

model CampaignStats {
  campaignId String   @id
  total      Int      @default(0)
  sent       Int      @default(0)
  failed     Int      @default(0)
  pending    Int      @default(0)

  updatedAt  DateTime @updatedAt

  campaign   Campaign @relation(fields: [campaignId], references: [id])
}

enum FlowStatus {
  draft
  published
  archived
}

enum SessionStatus {
  active
  waiting
  completed
  timed_out
  error
}

enum CampaignStatus {
  draft
  scheduled
  running
  completed
  cancelled
}

enum CampaignVersionStatus {
  draft
  ready
  cancelled
}

enum RecipientStatus {
  pending
  sent
  failed
  completed
}
