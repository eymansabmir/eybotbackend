generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Flow {
  id            String            @id @default(uuid())
  orgId         String
  name          String
  description   String?
  status        FlowStatus        @default(draft)
  version       Int               @default(1)
  triggerType   String
  triggerConfig Json
  nodes         Json
  edges         Json
  settings      Json
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  isConfigured  Boolean           @default(false)
  variables     Json?
  campaigns     Campaign[]
  translations  FlowTranslation[]
  renudgeConfig RenudgeConfig?
  renudgeLogs   RenudgeLog[]

  @@index([orgId, status])
}

model FlowTranslation {
  id             String   @id @default(uuid())
  flowId         String
  language       String
  translatedData Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  flow           Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, language], name: "flowId_language")
  @@index([flowId])
  @@map("flow_translations")
}

model ChatSession {
  id               String        @id @default(uuid())
  flowId           String        @default("")
  flowVersion      Int           @default(1)
  contactId        String?
  waId             String        @default("")
  waBusinessNumber String        @default("")
  status           SessionStatus @default(active)
  currentNodeId    String        @default("")
  variables        Json?
  history          Json?
  waitingFor       Json?
  isCurrent        Boolean       @default(true)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  flowStack        Json?
  lastRenudgeAt    DateTime?     @db.Timestamptz(3)
  renudgeAttempts  Int           @default(0)
  returnMark       Json?

  @@index([waId, status])
  @@index([flowId, status])
  @@index([waBusinessNumber, waId, isCurrent])
  @@map("chat_session")
}

model RenudgeConfig {
  id              String   @id @default(uuid())
  flowId          String   @unique
  enabled         Boolean  @default(false)
  durationMinutes Int      @default(30)
  maxAttempts     Int      @default(1)
  message         String   @default("Are you still there? Would you like to continue?")
  buttons         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  flow            Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("renudge_configs")
}

model RenudgeLog {
  id        String   @id @default(uuid())
  flowId    String
  waId      String
  sessionId String
  attempt   Int
  sentAt    DateTime @default(now())
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, waId])
  @@index([sessionId])
  @@map("renudge_logs")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Contact {
  id           String   @id @default(uuid())
  orgId        String
  waId         String
  name         String
  tags         String[]
  customFields Json?
  optIn        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, waId])
  @@index([orgId])
}

model Campaign {
  id              String            @id @default(uuid())
  orgId           String
  name            String
  flowId          String
  scheduleTime    DateTime?
  status          CampaignStatus    @default(draft)
  activeVersionId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  fieldMapping    Json?
  flow            Flow              @relation(fields: [flowId], references: [id])
  stats           CampaignStats?
  versions        CampaignVersion[]

  @@index([orgId, status])
}

model CampaignVersion {
  id            String                @id @default(uuid())
  campaignId    String
  filePath      String
  versionNumber Int
  status        CampaignVersionStatus @default(draft)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  recipients    CampaignRecipient[]
  campaign      Campaign              @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model CampaignRecipient {
  id                String          @id @default(uuid())
  campaignVersionId String
  waId              String
  variables         Json?
  status            RecipientStatus @default(pending)
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deliveredAt       DateTime?
  messageId         String?         @unique
  readAt            DateTime?
  repliedAt         DateTime?
  version           CampaignVersion @relation(fields: [campaignVersionId], references: [id])

  @@index([messageId])
  @@index([campaignVersionId, status])
  @@index([waId])
}

model CampaignStats {
  campaignId String   @id
  total      Int      @default(0)
  sent       Int      @default(0)
  failed     Int      @default(0)
  pending    Int      @default(0)
  completed  Int      @default(0)
  updatedAt  DateTime @updatedAt
  delivered  Int      @default(0)
  read       Int      @default(0)
  replied    Int      @default(0)
  campaign   Campaign @relation(fields: [campaignId], references: [id])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Credential {
  id             String          @id @default(uuid())
  orgId          String
  name           String
  type           CredentialType
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  keyVersion     Int             @default(1)
  metadata       Json?
  isActive       Boolean         @default(true)
  lastTestedAt   DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  voiceProviders VoiceProvider[]

  @@unique([orgId, type, name])
  @@index([orgId, type, isActive])
  @@map("credentials")
}

model EntityType {
  id             String                    @id @default(uuid())
  tenantId       String
  name           String
  fileId         String?
  type           String                    @default("AUTOMATIC")
  data           Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  attributes     EntityAttribute[]
  routingConfigs RoutingConfig[]
  events         VoiceOrchestrationEvent[]

  @@unique([tenantId, name])
  @@map("datasets")
}

model EntityAttribute {
  id           String     @id @default(uuid())
  tenantId     String
  entityTypeId String
  key          String
  type         String
  operators    Json
  values       Json?
  entityType   EntityType @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityTypeId, key])
  @@map("dataset_attributes")
}

model VoiceProvider {
  id           String                    @id @default(uuid())
  tenantId     String
  providerName String
  config       Json
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  credentialId String?
  routingRules RoutingRule[]
  events       VoiceOrchestrationEvent[]
  credential   Credential?               @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("voice_providers")
}

model RoutingConfig {
  id            String                    @id @default(uuid())
  tenantId      String
  name          String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  description   String?
  entityTypeId  String?
  status        ConfigStatus              @default(ACTIVE)
  type          RoutingType               @default(AUTOMATIC)
  entityTypeIds String[]                  @default([])
  entityType    EntityType?               @relation(fields: [entityTypeId], references: [id])
  rules         RoutingRule[]
  events        VoiceOrchestrationEvent[]

  @@index([tenantId])
  @@map("routing_configs")
}

model RoutingRule {
  id              String                    @id @default(uuid())
  routingConfigId String
  priority        Int
  conditions      Json
  action          Json
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  voiceProviderId String?
  routingConfig   RoutingConfig             @relation(fields: [routingConfigId], references: [id], onDelete: Cascade)
  voiceProvider   VoiceProvider?            @relation(fields: [voiceProviderId], references: [id])
  events          VoiceOrchestrationEvent[]

  @@index([routingConfigId])
  @@map("routing_rules")
}

model VoiceOrchestrationEvent {
  id              String         @id @default(uuid())
  tenantId        String
  traceId         String
  entityId        String?
  entityTypeId    String?
  routingConfigId String?
  voiceProviderId String?
  matchedRuleId   String?
  flow            String         @default("voice_orchestration")
  step            String
  status          Int?
  accepted        Boolean?
  message         String?
  durationMs      Int?
  metadata        Json?
  createdAt       DateTime       @default(now())
  entityType      EntityType?    @relation(fields: [entityTypeId], references: [id])
  matchedRule     RoutingRule?   @relation(fields: [matchedRuleId], references: [id])
  routingConfig   RoutingConfig? @relation(fields: [routingConfigId], references: [id])
  voiceProvider   VoiceProvider? @relation(fields: [voiceProviderId], references: [id])

  @@index([tenantId, traceId])
  @@index([createdAt])
  @@map("voice_orchestration_events")
}

model UserLanguagePreference {
  id                String   @id @default(uuid())
  botId             String
  waId              String
  preferredLanguage String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([botId, waId])
  @@index([botId, waId])
  @@map("user_language_preferences")
}

enum FlowStatus {
  draft
  published
  archived
}

enum SessionStatus {
  active
  waiting
  completed
  timed_out
  error
}

enum CampaignStatus {
  draft
  scheduled
  running
  completed
  cancelled
}

enum CampaignVersionStatus {
  draft
  ready
  cancelled
}

enum RecipientStatus {
  pending
  sent
  failed
  completed
  delivered
  read
  replied
}

enum CredentialType {
  OPENAI
  GOOGLE_SHEETS
  NOCODB
  ELEVENLABS
  ZAPIER
  HTTP_REQUEST
  ANTHROPIC
  MAKE
  DEEPSEEK
  WHATSAPP_CLOUD
  EXOTEL
  SARVAM
  VAPI
}

enum RoutingType {
  MANUAL
  AUTOMATIC
}

enum ConfigStatus {
  ACTIVE
  DRAFT
  PAUSED
}
